<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuzk_tools</name>
  <version>1.0.0</version>
  <description>Package for working with elevation and topography data from CUZK (ČÚZK---Český úřad zeměměřický a katastrální).</description>

  <author email="herolada@fel.cvut.cz">Adam Herold</author>
  <maintainer email="peckama2@fel.cvut.cz">Martin Pecka</maintainer>

  <license>BSD</license>

  <depend>rclpy</depend>

  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- <depend>jsk_recognition_msgs</depend> -->
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  
  <!-- <exec_depend>jsk_rviz_plugins</exec_depend> -->
  <!-- <exec_depend>osm_cartography</exec_depend> -->
  <!-- <exec_depend>ros_numpy</exec_depend> -->
  <exec_depend>tf2_ros</exec_depend>
  <!-- <exec_depend>unique_id</exec_depend> -->

  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-rtree</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-laspy</exec_depend>
  <exec_depend>python3-laszip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
